# Firebase Configuration
# Get service account credentials from: Firebase Console → Project Settings → Service Accounts → Generate New Private Key

# Option 1: Service account as JSON string (recommended)
# Add your Firebase service account JSON here (as one line)
FIREBASE_SERVICE_ACCOUNT=

# Option 2: Individual environment variables (if not using Option 1)
FIREBASE_PROJECT_ID=svn-global
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=

# Server Configuration
PORT=5000
NODE_ENV=development

# Session Secret (change in production)
SESSION_SECRET=svn-global-secret-key-2024-change-in-production

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000
VITE_FRONTEND_URL=http://localhost:3000

# Email Configuration (optional, for contact form)
EMAIL_USER=nagarajuwill@gmail.com
EMAIL_PASS=Svnglobal@2026
CONTACT_EMAIL=nagarajuwill@gmail.com
